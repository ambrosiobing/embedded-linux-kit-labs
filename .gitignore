# LaTeX build artifacts and scratch renders (regenerate with: python build.py)
build/
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# The built book stays local. Rebuild it with: python build.py
embedded-linux-kit-labs.pdf
embedded-linux-kit-labs.html

# Per-lab deliverables, built on demand with: python build.py --chapter N
lab-*.pdf
lab-*.html

# Local virtual environments and editor state
.venv/
venv/
.vscode/
.idea/
__pycache__/
*.pyc

# The labs' own evidence. A capture is what one bench produced on one day and
# a lab book is the baseline and thresholds that belong to it, so neither is
# source. Regenerate a synthetic one with: python -m p04 synth
*.npz
book.json
axis.json
labbook*.json

# What a local run of the checks workflow leaves behind
touch.txt
speech.txt
honest.npz
skewed.npz
